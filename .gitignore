.env
node_modules/
# Anchored, NOT a bare `data/`. A bare pattern matches every directory named
# `data` at any depth, which silently swallowed packages/server/src/data and
# packages/ui/src/data — the DuckDB data layer and the UI's data sources were
# never committed, so a clean clone of this repo did not build.
/.claude/skills/use-oracle/runtime/data/
dist/
.DS_Store

# Row hashes back the incremental delta computation. They are a 14 MB working
# file regenerated by every run, not a published artifact.
artifacts/row-hashes.json

# Published CARs are large and are reproducible from the run directory; the
# manifest records their CID and digest.
*.car

# Turborepo build cache and per-task logs are machine-local build output.
.turbo/

# Playwright's own output for the design lane: traces, screenshots and the HTML
# report are per-run artifacts, not source.
test-results/
playwright-report/
blob-report/
.playwright/

# Lambda deployment bundle: regenerated by `just bundle` from built output.
infra/bundle/
infra/cdk.out/
