.env
node_modules/
# Anchored, NOT a bare `data/`. A bare pattern matches every directory named
# `data` at any depth, which silently swallowed packages/server/src/data and
# packages/ui/src/data — the DuckDB data layer and the UI's data sources were
# never committed, so a clean clone of this repo did not build.
#
# The 1.7 GB pipeline working directory stays out, but the published run's small
# JSON record does not: the retrieval corpus is built from it, so with it ignored
# a rebuild produced 147 chunks against the committed index's 159 and the
# reproducibility test failed on any clean clone. Re-including needs the
# directory chain un-ignored too — git cannot re-include a file whose parent
# directory is excluded — hence `/**` plus the explicit walk down.
/pipeline/data/**
!/pipeline/data/
!/pipeline/data/artifacts/
!/pipeline/data/artifacts/publish/
!/pipeline/data/artifacts/publish/lake/
!/pipeline/data/artifacts/publish/lake/runs/
!/pipeline/data/artifacts/publish/lake/runs/*/
!/pipeline/data/artifacts/publish/lake/runs/*/coverage.json
!/pipeline/data/artifacts/publish/lake/runs/*/index.json
!/pipeline/data/artifacts/publish/lake/runs/*/schema.json
!/pipeline/data/artifacts/publish/lake/runs/*/permit-schema.json
!/pipeline/data/artifacts/publish/lake/runs/*/samples/
!/pipeline/data/artifacts/publish/lake/runs/*/samples/*.json
dist/
.DS_Store

# Row hashes back the incremental delta computation. They are a 14 MB working
# file regenerated by every run, not a published artifact.
artifacts/row-hashes.json

# Published CARs are large and are reproducible from the run directory; the
# manifest records their CID and digest.
*.car

# Turborepo build cache and per-task logs are machine-local build output.
.turbo/

# Playwright's own output for the design lane: traces, screenshots and the HTML
# report are per-run artifacts, not source.
test-results/
playwright-report/
blob-report/
.playwright/

# Lambda deployment bundle: regenerated by `just bundle` from built output.
infra/bundle/
infra/cdk.out/
pipeline/cdk.out/
pipeline/cdk.context.json
