  "provenance": {
    "sql": "SELECT\n  count(*) FILTER (WHERE coalesce(business_account_count, 0) > 0) AS properties_with_accounts,\n  sum(coalesce(business_account_count, 0)) AS business_accounts,\n  max(coalesce(business_account_count, 0)) AS max_accounts_at_one_property,\n  count(*) FILTER (WHERE coalesce(has_sunbiz_tenant, FALSE)) AS sunbiz_tenants,\n  count(*) AS properties\nFROM properties;\n\nSELECT\n  address_city AS city,\n  count(*) FILTER (WHERE coalesce(business_account_count, 0) > 0) AS properties_with_accounts,\n  sum(coalesce(business_account_count, 0)) AS business_accounts,\n  count(*) AS properties\nFROM properties\nWHERE address_city IS NOT NULL\nGROUP BY 1\nHAVING properties_with_accounts > 0\nORDER BY business_accounts DESC, city ASC\nLIMIT 40;\n\nSELECT\n  coalesce(property_type, 'unclassified') AS property_type,\n  count(*) FILTER (WHERE coalesce(business_account_count, 0) > 0) AS properties_with_accounts,\n  sum(coalesce(business_account_count, 0)) AS business_accounts\nFROM properties\nGROUP BY 1\nHAVING properties_with_accounts > 0\nORDER BY business_accounts DESC",
    "dataSource": "/Users/ricardoarcifa/Downloads/oracle-lake-fl-kit/pipeline/data/artifacts/publish/lake/runs/20260909T185056Z/query-table.parquet",
